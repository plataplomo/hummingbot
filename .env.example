# CyberDeltaEngine Docker Environment Variables
# Copy this file to .env and fill in your actual values

# Hyperliquid Configuration
HL_WALLET_ADDRESS=your_wallet_address_here
HL_PRIVATE_KEY=your_private_key_here

# Backpack Configuration
BP_API_KEY=your_backpack_api_key_here
BP_API_SECRET=your_backpack_api_secret_here

# Optional: Override default paths
# CYBERDELTA_CONFIG_PATH=/app/config/config.yaml
# CYBERDELTA_SECRETS_PATH=/home/trader/.cyberdelta/secrets.yaml

# Optional: Logging level
# LOG_LEVEL=INFO

# Optional: Dashboard settings
# DASHBOARD_HOST=0.0.0.0
# DASHBOARD_PORT=8050
