# --- Exchange API Keys ---
# Note: NEVER commit this file with actual keys!

# Backpack API Credentials
BACKPACK_API_KEY=your_backpack_api_key_here
BACKPACK_API_SECRET=your_backpack_api_secret_here

# Hyperliquid API Credentials (if applicable - often uses wallet signing)
# HYPERLIQUID_API_KEY="..."
# HYPERLIQUID_API_SECRET="..."
# Or potentially private key for wallet interaction (handle with extreme care)
HYPERLIQUID_WALLET_PRIVATE_KEY=your_hyperliquid_private_key_here
HYPERLIQUID_WALLET_ADDRESS=your_hyperliquid_address_here

# Paradex API Credentials (if applicable - likely uses wallet signing)
# PARADEX_API_KEY="..."
# PARADEX_API_SECRET="..."
PARADEX_WALLET_PRIVATE_KEY="YOUR_PARADEX_WALLET_PRIVATE_KEY"


# --- Bridge API Keys (if needed) ---
# ACROSS_API_KEY="..."

# --- Oracle API Keys (if needed) ---
# CHAINLINK_API_KEY="..."

# --- Other Secrets ---
# Example: Password for an encrypted key file
# KEY_FILE_PASSWORD="..."

# Feature flags
ENABLE_TRADING=false  # Set to true to enable actual trading

# Risk management
MAX_POSITION_SIZE_USD=1000
MAX_TOTAL_EXPOSURE_USD=5000 