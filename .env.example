# CyberDeltaEngine Environment Variables Example
# Copy this file to .env and modify as needed

# Configuration file paths
CYBERDELTA_CONFIG_PATH=/path/to/your/config.yaml
CYBERDELTA_SECRETS_PATH=~/.cyberdelta/secrets.yaml

# Logging
LOG_LEVEL=INFO

# Development mode
DEVELOPMENT_MODE=true
SAFE_MODE=true

# API Testing
TEST_API_CALLS=false 