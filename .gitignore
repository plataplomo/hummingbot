# Worktree-specific .gitignore for CyberDeltaEngine
worktrees.code-workspace

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info

# Docker
.env
.env.local
.env.*.local/
.installed.cfg
*.egg
.mypy_cache/
.ruff_cache/

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
node_modules/

# IDE files
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Testing
.tox/
.coverage
htmlcov/
.pytest_cache/
.hypothesis/
nosetests.xml
coverage.xml
*.cover
logs/

# VCR Cassettes - recorded HTTP interactions
# tests/cassettes/

# Secrets - IMPORTANT: Never commit secrets!
secrets.yaml
**/secrets.yaml
/config/secrets.yaml
/cyberdelta/config/secrets.yaml
~/.cyberdelta/secrets.yaml
/home/*/.cyberdelta/secrets.yaml
logs/cyberdelta.log
