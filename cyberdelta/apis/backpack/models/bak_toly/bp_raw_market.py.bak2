"""
Backpack API Order Models (RAW - Hardened Validation - COMPLETE)
-------------------------------------------------------------

Strict Pydantic models for validating order, order book, and order update
responses from the Backpack Exchange API. Used for boundary validation ONLY.

- Fully aligned with Backpack OpenAPI spec examples and WS stream fields.
- Supports ALL known REST/WS field aliases via populate_by_name=True.
- Applies robust validators for type, format, emptiness, length, UTF-8.
- Extra fields forbidden. No business logic. No internal model mapping.
"""

import logging  # Import logging
from typing import Any  # Use standard List/Optional

from pydantic import (
    BaseModel,
    ConfigDict,
    Field,
    ValidationInfo,
    field_validator,
    model_validator,
)

# Assume parsing utilities are correctly placed and imported
from cyberdelta.utils.parsing import parse_datetime_utc, parse_decimal_value

logger = logging.getLogger(__name__)  # Define logger

# --- Reusable Validators (Internal to this module or import from utils) ---
# Implementing the hardened patterns directly here as mandated.


def _validate_required_string(v: Any, info: ValidationInfo, max_len: int = 64) -> str:
    """Strictly validates required string fields (type, non-empty, length, utf-8)."""
    field_name = info.field_name or "field"
    if not isinstance(v, str):
        raise ValueError(f"{field_name}: Input must be string, got {type(v).__name__}")
    v_stripped = v.strip()  # Use stripped for check, return original v
    if not v_stripped:
        raise ValueError(f"{field_name}: Input string cannot be empty.")
    if len(v) > max_len:
        raise ValueError(f"{field_name}: String too long (max {max_len} chars)")
    try:
        v.encode("utf-8", "strict")
    except UnicodeEncodeError as e:
        raise ValueError(f"{field_name}: Invalid UTF-8: {e}") from e
    return v


def _validate_optional_string(v: Any, info: ValidationInfo, max_len: int = 64) -> str | None:
    """Strictly validates optional string fields if present (type, length, utf-8). Allows empty strings."""
    field_name = info.field_name or "field"
    if v is None:
        return None
    if not isinstance(v, str):
        raise ValueError(f"{field_name}: Input must be string or None, got {type(v).__name__}")
    # Optional fields can be empty strings unless specifically disallowed elsewhere
    if len(v) > max_len:
        raise ValueError(f"{field_name}: String too long (max {max_len} chars)")
    try:
        v.encode("utf-8", "strict")
    except UnicodeEncodeError as e:
        raise ValueError(f"{field_name}: Invalid UTF-8: {e}") from e
    return v


def _validate_decimal_string(v: Any, info: ValidationInfo, allow_none: bool) -> str | None:
    """Strictly validates required or optional decimal string fields."""
    field_name = info.field_name or "field"
    max_len = 64  # Default max length
    if v is None:
        if allow_none:
            return None
        else:
            raise ValueError(f"{field_name}: Field is required and cannot be None.")
    if not isinstance(v, str):
        raise ValueError(f"{field_name}: Input must be string, got {type(v).__name__}")
    v_stripped = v.strip()
    if not v_stripped:
        raise ValueError(f"{field_name}: Input cannot be empty or just whitespace.")
    if len(v) > max_len:
        raise ValueError(f"{field_name}: String value too long (max {max_len} chars)")
    try:
        # Attempt conversion using utility parser (which raises ValueError on failure)
        # Use allow_none=False here because we already handled the None case above
        dec_val = parse_decimal_value(v, allow_none=False, field_name=field_name)
        # parse_decimal_value already checks if result is None when allow_none=False
        if not dec_val.is_finite():  # Check for NaN, Infinity
            raise ValueError(f"Value must be finite: '{v}'")
    except ValueError as e:
        # Re-raise wrapped error
        raise ValueError(f"{field_name}: Invalid decimal string format '{v}': {e}") from e
    # Return the ORIGINAL validated string for the Raw model
    return v


def _validate_timestamp(v: Any, info: ValidationInfo, allow_none: bool) -> Any | None:
    """Strictly validates required or optional timestamp fields (int, float, non-empty str)."""
    field_name = info.field_name or "timestamp"
    if v is None:
        if allow_none:
            return None
        else:
            raise ValueError(f"{field_name}: Field is required and cannot be None.")
    # Check for valid input types
    if not isinstance(v, (int, float, str)):
        raise ValueError(f"{field_name}: Invalid type {type(v).__name__}, expected int/float/str")
    # Check for empty string if input is string
    if isinstance(v, str) and not v.strip():
        raise ValueError(f"{field_name}: Timestamp string cannot be empty or just whitespace.")
    # Attempt parsing using utility to validate format/value
    try:
        _ = parse_datetime_utc(v, field_name=field_name)  # We only care if it raises ValueError
    except ValueError as e:
        # Re-raise wrapped error for Pydantic
        raise ValueError(f"{field_name}: Invalid timestamp format or value '{v}': {e}") from e
    # Return the original validated raw value (int, float, or str)
    return v


def _validate_list_of_decimal_strings(v: Any, info: ValidationInfo) -> list[list[str]]:
    """Validates structure and format of bids/asks lists."""
    field_name = info.field_name or "levels"
    if not isinstance(v, list):
        raise ValueError(f"{field_name}: Must be a list.")
    validated_levels = []
    for index, item in enumerate(v):
        item_field_prefix = f"{field_name}[{index}]"
        if not isinstance(item, list):
            raise ValueError(f"{item_field_prefix}: Item must be a list.")
        if len(item) != 2:
            raise ValueError(f"{item_field_prefix}: Item must have 2 elements [price, qty].")

        price_str = item[0]
        qty_str = item[1]

        # Validate price string (use internal helper - need ValidationInfo)
        try:
            _validate_decimal_string(
                price_str, ValidationInfo(field_name=f"{item_field_prefix}.price"), allow_none=False
            )
        except ValueError as e:
            raise ValueError(f"{item_field_prefix}: Invalid price - {e}") from e

        # Validate quantity string
        try:
            _validate_decimal_string(
                qty_str,
                ValidationInfo(field_name=f"{item_field_prefix}.quantity"),
                allow_none=False,
            )
        except ValueError as e:
            raise ValueError(f"{item_field_prefix}: Invalid quantity - {e}") from e

        # If item passes, add ORIGINAL strings to result
        validated_levels.append([price_str, qty_str])
    return validated_levels


# --- Raw Models ---


class BackpackRawOrder(BaseModel):
    """Raw order object - VALIDATED"""

    # Using Field aliases handled by populate_by_name=True in ConfigDict

    # --- Identifiers ---
    clientId: str | None = Field(None, alias="c", description="Client order ID.", max_length=64)
    id: str = Field(..., alias="i", description="Exchange order ID.", max_length=64)
    relatedOrderId: str | None = Field(
        None, alias="I", description="Related order ID.", max_length=64
    )

    # --- Basic Details ---
    symbol: str = Field(..., alias="s", description="Trading symbol.", max_length=64)
    side: str = Field(..., alias="S", description="Order side ('Bid', 'Ask').", max_length=16)
    orderType: str = Field(
        ..., alias="o", description="Order type ('LIMIT', 'MARKET').", max_length=32
    )
    status: str = Field(
        ..., alias="X", description="Order status ('NEW', 'FILLED', etc.).", max_length=32
    )

    # --- Quantities ---
    quantity: str = Field(..., alias="q", description="Requested order quantity.", max_length=64)
    executedQuantity: str | None = Field(
        None, alias="z", description="Total filled quantity.", max_length=64
    )
    executedQuoteQuantity: str | None = Field(
        None, alias="Z", description="Filled quote quantity.", max_length=64
    )

    # --- Pricing ---
    price: str | None = Field(None, alias="p", description="Limit price.", max_length=64)
    triggerPrice: str | None = Field(
        None, alias="P", description="Stop/trigger price.", max_length=64
    )
    avgFillPrice: str | None = Field(
        None, alias="L", description="Weighted average fill price.", max_length=64
    )

    # --- Modifiers ---
    triggerBy: str | None = Field(
        None, alias="B", description="Reference price type for triggers.", max_length=32
    )
    timeInForce: str | None = Field(None, alias="f", description="Time in force.", max_length=8)
    reduceOnly: bool | None = Field(None, alias="r", description="Reduce-only flag.")
    postOnly: bool | None = Field(None, alias="postOnly", description="Post-only flag (REST only).")
    selfTradePrevention: str | None = Field(
        None, alias="V", description="Self-trade prevention behavior.", max_length=32
    )

    # --- Timestamps ---
    # Aliases handled by @model_validator below
    createdAt: Any = Field(..., description="Order creation time (UTC).")
    updatedAt: Any | None = Field(None, description="Last update time.")
    triggeredAt: Any | None = Field(None, description="Time conditional order triggered.")
    # WS specific timestamp alias T
    engine_timestamp: Any | None = Field(None, alias="T", description="Engine timestamp (WS, µs).")
    # WS specific timestamp alias E
    event_time: Any | None = Field(None, alias="E", description="Event time (WS, µs).")

    # --- Status/Lifecycle Details ---
    expiryReason: str | None = Field(
        None, alias="R", description="Reason for expiry/cancellation.", max_length=64
    )
    origin: str | None = Field(
        None, alias="O", description="Origin of the last update.", max_length=64
    )

    # --- WebSocket Specific Fill Details ---
    fill_quantity: str | None = Field(
        None, alias="l", description="Quantity of the last fill (WS).", max_length=64
    )
    # Note: fill_price uses same alias 'L' as avgFillPrice. Alias handling might prioritize one. Needs careful testing.
    # Re-aliasing avgFillPrice to avoid conflict if needed:
    # avgFillPrice_rest: Optional[str] = Field(None, alias="avgFillPrice")
    fill_price: str | None = Field(
        None, alias="L", description="Price of the last fill (WS).", max_length=64
    )
    fee_amount: str | None = Field(
        None, alias="n", description="Fee amount for the last fill (WS).", max_length=64
    )
    fee_asset: str | None = Field(
        None, alias="N", description="Fee asset for the last fill (WS).", max_length=32
    )
    is_maker_fill: bool | None = Field(
        None, alias="m", description="Whether last fill was maker (WS)."
    )
    trade_id_fill: str | None = Field(
        None, alias="t", description="Trade ID of the last fill (WS).", max_length=64
    )

    model_config = ConfigDict(populate_by_name=True, extra="forbid")

    # --- Alias Resolution for Timestamps (Handles multiple potential keys) ---
    @model_validator(mode="before")
    @classmethod
    def unify_timestamps(cls, values: dict[str, Any]) -> dict[str, Any]:
        """Ensure createdAt uses 'E', 'T', or 'time' if 'createdAt' itself is missing."""
        # Prioritize specific 'createdAt' if present
        if "createdAt" in values:
            values["createdAt"] = values["createdAt"]  # Keep existing
        # Fallback to WebSocket keys ('E' preferred over 'T'?) or 'time'
        elif "E" in values:
            values["createdAt"] = values["E"]
        elif "T" in values:
            values["createdAt"] = values["T"]
        elif "time" in values:
            values["createdAt"] = values["time"]
        # No need to handle updatedAt/triggeredAt aliases if they are single-source

        # Resolve potential alias conflict L (avgFillPrice vs fill_price)
        # If both 'L' and 'avgFillPrice' aliases might be present from different sources,
        # need logic here to prioritize or handle. Assuming Pydantic uses first alias match.
        # Explicitly:
        if "L" in values and "avgFillPrice" not in values:
            # If only 'L' exists, assume it's avgFillPrice unless context suggests otherwise
            # If context is definitely a fill event, maybe map to fill_price? Complex.
            # Safest might be to keep 'L' mapped primarily to avgFillPrice via alias,
            # and handle fill_price explicitly during transformation if needed.
            pass  # Rely on alias for avgFillPrice for now

        return values

    # --- Field Validators using Helpers ---
    _validate_id = field_validator("id", mode="before")(
        lambda v, info: _validate_required_string(v, info, max_len=64)
    )
    _validate_symbol = field_validator("symbol", mode="before")(
        lambda v, info: _validate_required_string(v, info, max_len=64)
    )
    _validate_side = field_validator("side", mode="before")(
        lambda v, info: _validate_required_string(v, info, max_len=16)
    )
    _validate_orderType = field_validator("orderType", mode="before")(
        lambda v, info: _validate_required_string(v, info, max_len=32)
    )
    _validate_status = field_validator("status", mode="before")(
        lambda v, info: _validate_required_string(v, info, max_len=32)
    )

    _validate_opt_clientId = field_validator("clientId", mode="before")(
        lambda v, info: _validate_optional_string(v, info, max_len=64)
    )
    _validate_opt_relatedOrderId = field_validator("relatedOrderId", mode="before")(
        lambda v, info: _validate_optional_string(v, info, max_len=64)
    )
    _validate_opt_triggerBy = field_validator("triggerBy", mode="before")(
        lambda v, info: _validate_optional_string(v, info, max_len=32)
    )
    _validate_opt_timeInForce = field_validator("timeInForce", mode="before")(
        lambda v, info: _validate_optional_string(v, info, max_len=8)
    )
    _validate_opt_selfTradePrevention = field_validator("selfTradePrevention", mode="before")(
        lambda v, info: _validate_optional_string(v, info, max_len=32)
    )
    _validate_opt_expiryReason = field_validator("expiryReason", mode="before")(
        lambda v, info: _validate_optional_string(v, info, max_len=64)
    )
    _validate_opt_origin = field_validator("origin", mode="before")(
        lambda v, info: _validate_optional_string(v, info, max_len=64)
    )
    _validate_opt_fee_asset = field_validator("fee_asset", mode="before")(
        lambda v, info: _validate_optional_string(v, info, max_len=32)
    )
    _validate_opt_trade_id_fill = field_validator("trade_id_fill", mode="before")(
        lambda v, info: _validate_optional_string(v, info, max_len=64)
    )

    _validate_req_decimal_str_qty = field_validator("quantity", mode="before")(
        lambda v, info: _validate_decimal_string(v, info, allow_none=False)
    )
    _validate_opt_decimal_str_common = field_validator(
        "executedQuantity",
        "executedQuoteQuantity",
        "price",
        "triggerPrice",
        "avgFillPrice",
        "fill_quantity",
        "fill_price",
        "fee_amount",
        mode="before",
    )(lambda v, info: _validate_decimal_string(v, info, allow_none=True))

    _validate_req_timestamp_created = field_validator("createdAt", mode="before")(
        lambda v, info: _validate_timestamp(v, info, allow_none=False)
    )
    _validate_opt_timestamp_others = field_validator(
        "updatedAt", "triggeredAt", "engine_timestamp", "event_time", mode="before"
    )(lambda v, info: _validate_timestamp(v, info, allow_none=True))

    # --- Post-Validation Enum Checks ---
    @field_validator(
        "side",
        "orderType",
        "status",
        "timeInForce",
        "selfTradePrevention",
        "expiryReason",
        "origin",
        mode="after",
    )
    @classmethod
    def check_enum_values(cls, v: str, info: ValidationInfo) -> str:
        # This runs *after* basic string validation
        if v is None:
            return v  # Skip check if optional field is None
        field_name = info.field_name
        allowed_values: set[str] = set()

        # Define known raw values from API spec for each field
        if field_name == "side":
            allowed_values = {"buy", "sell", "Bid", "Ask"}
        elif field_name == "orderType":
            allowed_values = {"LIMIT", "MARKET"}  # Add STOP etc. if known raw values exist
        elif field_name == "status":
            allowed_values = {
                "NEW",
                "FILLED",
                "CANCELLED",
                "EXPIRED",
                "REJECTED",
                "PARTIALLY_FILLED",
                "TriggerPending",
                "TriggerFailed",
                "orderAccepted",
                "orderCancelled",
                "orderExpired",
                "orderFill",
                "orderModified",
                "triggerPlaced",
                "triggerFailed",
            }  # Combine REST/WS known values
        elif field_name == "timeInForce":
            allowed_values = {"GTC", "IOC", "FOK"}
        elif field_name == "selfTradePrevention":
            allowed_values = {"RejectTaker", "RejectMaker", "RejectBoth"}
        elif field_name == "expiryReason":
            allowed_values = {
                member.value
                for member in OrderExpiryReason
                if member != OrderExpiryReason.UNKNOWN
                and member != OrderExpiryReason.USER_CANCELLED
            }  # Use your Enum
        elif field_name == "origin":
            allowed_values = {
                member.value for member in OrderUpdateOrigin if member != OrderUpdateOrigin.UNKNOWN
            }  # Use your Enum
        # Add checks for triggerBy if needed

        if allowed_values and v not in allowed_values:
            # Check case-insensitively only if strict match fails? Or just fail? Be strict.
            raise ValueError(
                f"{field_name}: Invalid raw API value '{v}'. Expected one of {allowed_values}"
            )
        return v


class BackpackRawOrderBook(BaseModel):
    """Raw order book snapshot - VALIDATED"""

    symbol: str = Field(..., max_length=64)
    bids: list[list[str]] = Field(...)  # List of [price_str, qty_str]
    asks: list[list[str]] = Field(...)  # List of [price_str, qty_str]
    time: Any = Field(...)  # Timestamp (validated below)
    # Add lastUpdateId if needed from spec
    # lastUpdateId: Optional[str] = Field(None)

    model_config = ConfigDict(populate_by_name=True, extra="forbid")

    # --- Validators ---
    _validate_symbol = field_validator("symbol", mode="before")(
        lambda v, info: _validate_required_string(v, info, max_len=64)
    )
    _validate_time = field_validator("time", mode="before")(
        lambda v, info: _validate_timestamp(v, info, allow_none=False)
    )

    @field_validator("bids", "asks", mode="before")
    @classmethod
    def validate_levels(cls, v: Any, info: ValidationInfo) -> list[list[str]]:
        """Validates structure and format of bids/asks lists."""
        field_name = info.field_name or "levels"
        if not isinstance(v, list):
            raise ValueError(f"{field_name}: Must be a list.")
        validated_levels = []
        for index, item in enumerate(v):
            item_field_prefix = f"{field_name}[{index}]"
            if not isinstance(item, list):
                raise ValueError(f"{item_field_prefix}: Item must be a list.")
            if len(item) != 2:
                raise ValueError(f"{item_field_prefix}: Item must have 2 elements [price, qty].")

            price_str = item[0]
            qty_str = item[1]

            # Validate price string (use internal helper)
            try:
                _validate_decimal_string(
                    price_str,
                    ValidationInfo(field_name=f"{item_field_prefix}.price", context=info.context),
                    allow_none=False,
                )
            except ValueError as e:
                raise ValueError(f"{item_field_prefix}: Invalid price - {e}") from e

            # Validate quantity string
            try:
                _validate_decimal_string(
                    qty_str,
                    ValidationInfo(
                        field_name=f"{item_field_prefix}.quantity", context=info.context
                    ),
                    allow_none=False,
                )
            except ValueError as e:
                raise ValueError(f"{item_field_prefix}: Invalid quantity - {e}") from e

            validated_levels.append([price_str, qty_str])  # Keep original strings
        return validated_levels


class BackpackRawOrderUpdate(BaseModel):
    """Raw order update event from WebSocket - VALIDATED"""

    # Using aliases derived from WS spec examples

    event_type: str = Field(..., alias="e", max_length=32)
    event_time: Any = Field(..., alias="E")  # Validated below
    symbol: str = Field(..., alias="s", max_length=64)
    client_order_id: str | None = Field(None, alias="c", max_length=64)
    side: str = Field(..., alias="S", max_length=16)  # 'Bid' or 'Ask'
    order_type: str = Field(..., alias="o", max_length=32)  # 'LIMIT', 'MARKET', etc.
    time_in_force: str | None = Field(None, alias="f", max_length=8)
    quantity: str | None = Field(None, alias="q", max_length=64)  # Original requested qty?
    price: str | None = Field(None, alias="p", max_length=64)  # Limit price?
    order_status: str = Field(..., alias="X", max_length=32)  # Status like 'NEW', 'FILLED'

    # WebSocket specific fill/update fields (Aliases from WS Spec examples)
    exchange_order_id: str | None = Field(None, alias="i", max_length=64)
    quantity_filled: str | None = Field(
        None, alias="z", max_length=64
    )  # Executed quantity (total filled?)
    quote_quantity_filled: str | None = Field(None, alias="Z", max_length=64)  # Executed quote qty
    last_fill_quantity: str | None = Field(
        None, alias="l", max_length=64
    )  # Fill quantity for *this* event
    # Re-aliasing avgFillPrice to avoid conflict with L for last_fill_price
    avgFillPrice: str | None = Field(
        None, alias="avgFillPrice", description="Weighted average fill price.", max_length=64
    )
    last_fill_price: str | None = Field(
        None, alias="L", description="Price of the last fill (WS).", max_length=64
    )
    is_maker: bool | None = Field(None, alias="m")  # If last fill was maker
    fee_amount: str | None = Field(None, alias="n", max_length=64)  # Fee for last fill
    fee_asset: str | None = Field(None, alias="N", max_length=32)  # Fee asset for last fill
    trade_id: str | None = Field(None, alias="t", max_length=64)  # Trade ID for last fill
    engine_timestamp: Any | None = Field(None, alias="T")  # Engine timestamp (µs), validated below
    origin: str | None = Field(None, alias="O", max_length=64)  # Origin (USER, LIQUIDATION...)
    related_order_id_ws: str | None = Field(
        None, alias="I", max_length=64
    )  # Related order ID (WS specific?)
    reduce_only_ws: bool | None = Field(None, alias="r")  # Reduce only flag (WS specific?)
    expiry_reason_ws: str | None = Field(
        None, alias="R", max_length=64
    )  # Expiry reason (WS specific?)
    stop_price_ws: str | None = Field(
        None, alias="P", max_length=64
    )  # Trigger price (WS specific?)
    trigger_by_ws: str | None = Field(None, alias="B", max_length=32)  # Trigger by (WS specific?)
    # Add TP fields a, b, d, g if needed from spec

    model_config = ConfigDict(populate_by_name=True, extra="forbid")

    # --- Reusable Validators Applied ---
    _validate_req_str32 = field_validator(
        "event_type", "order_type", "order_status", mode="before"
    )(lambda v, info: _validate_required_string(v, info, max_len=32))
    _validate_req_str64 = field_validator("symbol", mode="before")(
        lambda v, info: _validate_required_string(v, info, max_len=64)
    )
    _validate_req_str16 = field_validator("side", mode="before")(
        lambda v, info: _validate_required_string(v, info, max_len=16)
    )

    _validate_opt_str64 = field_validator(
        "client_order_id",
        "exchange_order_id",
        "related_order_id_ws",
        "trade_id",
        "expiry_reason_ws",
        "origin",
        mode="before",
    )(lambda v, info: _validate_optional_string(v, info, max_len=64))
    _validate_opt_str32 = field_validator("trigger_by_ws", "fee_asset", mode="before")(
        lambda v, info: _validate_optional_string(v, info, max_len=32)
    )
    _validate_opt_str8 = field_validator("time_in_force", mode="before")(
        lambda v, info: _validate_optional_string(v, info, max_len=8)
    )

    _validate_opt_decimal_str = field_validator(
        "quantity",
        "price",
        "quantity_filled",
        "quote_quantity_filled",
        "last_fill_quantity",
        "last_fill_price",
        "fee_amount",
        "stop_price_ws",
        "avgFillPrice",  # Added avgFillPrice here
        mode="before",
    )(lambda v, info: _validate_decimal_string(v, info, allow_none=True))

    _validate_req_timestamp_event = field_validator("event_time", mode="before")(
        lambda v, info: _validate_timestamp(v, info, allow_none=False)
    )
    _validate_opt_timestamp_engine = field_validator("engine_timestamp", mode="before")(
        lambda v, info: _validate_timestamp(v, info, allow_none=True)
    )

    # Add specific Enum checks after basic validation
    @field_validator("event_type", mode="after")
    @classmethod
    def check_event_type_value(cls, v: str) -> str:
        allowed = {
            "orderAccepted",
            "orderCancelled",
            "orderExpired",
            "orderFill",
            "orderModified",
            "triggerPlaced",
            "triggerFailed",
        }
        if v not in allowed:
            raise ValueError(f"Invalid event_type value: '{v}'")
        return v

    @field_validator("side", mode="after")
