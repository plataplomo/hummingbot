"""
Backpack API Order Models (RAW - Hardened Validation - COMPLETE)
-------------------------------------------------------------

Strict Pydantic models for validating order, order book, and order update
responses from the Backpack Exchange API. Used for boundary validation ONLY.

- Fully aligned with Backpack OpenAPI spec examples and WS stream fields.
- Supports ALL known REST/WS field aliases via populate_by_name=True.
- Applies robust validators for type, format, emptiness, length, UTF-8.
- Extra fields forbidden. No business logic. No internal model mapping.
"""

import logging  # Import logging
from typing import Any  # Use standard List/Optional

from pydantic import (
    BaseModel,
    ConfigDict,
    Field,
    ValidationInfo,
    field_validator,
)

# Assume parsing utilities are correctly placed and imported
from cyberdelta.utils.parsing import parse_datetime_utc, parse_decimal_value

logger = logging.getLogger(__name__)  # Define logger


# --- Reusable Validators (Internal to this module or import from utils) ---
# These should ideally live in utils/validation.py but defined here for self-containment


def _validate_required_string(v: Any, info: ValidationInfo, max_len: int = 64) -> str:
    """Strictly validates required string fields (type, non-empty, length, utf-8)."""
    field_name: str = info.field_name or "field"
    if not isinstance(v, str):
        raise ValueError(f"{field_name}: Input must be string, got {type(v).__name__}")
    if not v.strip():
        raise ValueError(f"{field_name}: Input string cannot be empty.")
    if len(v) > max_len:
        raise ValueError(f"{field_name}: String too long (max {max_len} chars)")
    try:
        v.encode("utf-8", "strict")
    except UnicodeEncodeError as e:
        raise ValueError(f"{field_name}: Invalid UTF-8: {e}") from e
    return v


def _validate_optional_string(v: Any, info: ValidationInfo, max_len: int = 64) -> str | None:
    """Strictly validates optional string fields if present (type, length, utf-8)."""
    field_name: str = info.field_name or "field"
    if v is None:
        return None
    if not isinstance(v, str):
        raise ValueError(f"{field_name}: Input must be string or None, got {type(v).__name__}")
    # Allow empty strings for optional fields unless a different validator forbids it
    if len(v) > max_len:
        raise ValueError(f"{field_name}: String too long (max {max_len} chars)")
    try:
        v.encode("utf-8", "strict")
    except UnicodeEncodeError as e:
        raise ValueError(f"{field_name}: Invalid UTF-8: {e}") from e
    return v


def _validate_decimal_string(v: Any, info: ValidationInfo, allow_none: bool) -> str | None:
    """Strictly validates required or optional decimal string fields."""
    field_name: str = info.field_name or "field"
    max_len: int = 64  # Max length for decimal strings
    if v is None:
        if allow_none:
            return None
        else:
            raise ValueError(f"{field_name}: Field is required.")
    if not isinstance(v, str):
        raise ValueError(f"{field_name}: Input must be string, got {type(v).__name__}")
    if not v.strip():
        raise ValueError(f"{field_name}: Input cannot be empty.")
    if len(v) > max_len:
        raise ValueError(f"{field_name}: String too long (max {max_len} chars)")
    try:
        # Use utility parser which includes checks
        dec_val = parse_decimal_value(v, allow_none=False, field_name=field_name)  # Test parsing
        if dec_val is None:
            raise ValueError("Parsing returned None unexpectedly.")  # Should not happen
        if not dec_val.is_finite():
            raise ValueError(f"Value must be finite: '{v}'")
    except ValueError as e:
        raise ValueError(f"{field_name}: Invalid decimal string '{v}': {e}") from e
    # Return original string if checks pass
    return v


def _validate_timestamp(v: Any, info: ValidationInfo, allow_none: bool) -> Any | None:
    """Strictly validates required or optional timestamp fields (int, float, non-empty str)."""
    field_name: str = info.field_name or "timestamp"
    if v is None:
        if allow_none:
            return None
        else:
            raise ValueError(f"{field_name}: Field is required.")
    if not isinstance(v, int | float | str):
        raise ValueError(f"{field_name}: Invalid type {type(v)}, expected int/float/str")
    if isinstance(v, str) and not v.strip():
        raise ValueError(f"{field_name}: Timestamp string cannot be empty")
    try:
        # Use utility just to check parsability
        _ = parse_datetime_utc(v, field_name=field_name)
    except ValueError as e:
        # Wrap error for consistent reporting
        raise ValueError(f"{field_name}: Invalid timestamp format or value '{v}': {e}") from e
    # Return original validated raw value (int, float, or str)
    return v


# --- Raw Models ---


class BackpackRawOrder(BaseModel):
    """
    Pydantic model for a raw order object from `/api/v1/order`, `/api/v1/orders`,
    or WebSocket order update events. Validates against the superset of known fields
    and aliases from REST and WebSocket specifications.
    """

    # --- Identifiers (Aliases: i, c, I) ---
    id: str = Field(..., alias="id", description="Exchange order ID.")
    clientId: str | None = Field(None, alias="clientId", description="Client order ID.")
    relatedOrderId: str | None = Field(
        None, alias="relatedOrderId", description="Related order ID."
    )

    # --- Basic Details (Aliases: s, S, o, X) ---
    symbol: str = Field(..., alias="symbol", description="Trading symbol.")
    side: str = Field(..., alias="side", description="Order side ('buy'/'sell', 'Bid'/'Ask').")
    orderType: str = Field(
        ..., alias="orderType", description="Order type ('LIMIT', 'MARKET', etc.)."
    )
    status: str = Field(..., alias="status", description="Order status ('NEW', 'FILLED', etc.).")

    # --- Quantities (Aliases: q, z, Z) ---
    quantity: str = Field(..., alias="quantity", description="Requested order quantity.")
    executedQuantity: str | None = Field(
        None, alias="executedQuantity", description="Total filled quantity."
    )
    executedQuoteQuantity: str | None = Field(
        None, alias="executedQuoteQuantity", description="Filled quote quantity."
    )

    # --- Pricing (Aliases: p, P, L) ---
    price: str | None = Field(None, alias="price", description="Limit price.")
    triggerPrice: str | None = Field(None, alias="triggerPrice", description="Stop/trigger price.")
    avgFillPrice: str | None = Field(
        None, alias="avgFillPrice", description="Weighted average fill price."
    )

    # --- Modifiers (Aliases: B, f, r, V) ---
    triggerBy: str | None = Field(
        None, alias="triggerBy", description="Reference price type for triggers."
    )
    timeInForce: str | None = Field(None, alias="timeInForce", description="Time in force.")
    reduceOnly: bool | None = Field(None, alias="reduceOnly", description="Reduce-only flag.")
    postOnly: bool | None = Field(None, alias="postOnly", description="Post-only flag (REST only).")
    selfTradePrevention: str | None = Field(
        None, alias="selfTradePrevention", description="Self-trade prevention behavior."
    )

    # --- Timestamps (Aliases: E, T, time) ---
    createdAt: Any = Field(..., alias="createdAt", description="Order creation time (UTC).")
    updatedAt: Any | None = Field(None, alias="updatedAt", description="Last update time.")
    triggeredAt: Any | None = Field(
        None, alias="triggeredAt", description="Time conditional order triggered."
    )

    # --- Status/Lifecycle Details (Aliases: R, O) ---
    expiryReason: str | None = Field(
        None, alias="expiryReason", description="Reason for expiry/cancellation."
    )
    origin: str | None = Field(None, alias="origin", description="Origin of the last update.")

    # --- WebSocket Specific Fill Details (Aliases: l, n, N, m, t) ---
    # These appear in WS 'orderFill' event type within the main order update structure
    fill_quantity: str | None = Field(
        None, alias="l", description="Quantity of the last fill (WS)."
    )
    fill_price: str | None = Field(
        None,
        alias="L",
        description="Price of the last fill (WS - same alias as avgFillPrice?). Verify.",
    )
    fee_amount: str | None = Field(
        None, alias="n", description="Fee amount for the last fill (WS)."
    )
    fee_asset: str | None = Field(None, alias="N", description="Fee asset for the last fill (WS).")
    is_maker_fill: bool | None = Field(
        None, alias="m", description="Whether last fill was maker (WS)."
    )
    trade_id_fill: str | None = Field(
        None, alias="t", description="Trade ID of the last fill (WS)."
    )

    model_config = ConfigDict(populate_by_name=True, extra="forbid")

    # --- Validators applying the patterns ---

    # Validate required strings (apply appropriate max_length if known)
    _validate_id = field_validator("id", mode="before")(
        lambda v, info: _validate_required_string(v, info, max_len=64)
    )
    _validate_symbol = field_validator("symbol", mode="before")(
        lambda v, info: _validate_required_string(v, info, max_len=64)
    )
    _validate_side = field_validator("side", mode="before")(
        lambda v, info: _validate_required_string(v, info, max_len=16)
    )
    _validate_orderType = field_validator("orderType", mode="before")(
        lambda v, info: _validate_required_string(v, info, max_len=32)
    )
    _validate_status = field_validator("status", mode="before")(
        lambda v, info: _validate_required_string(v, info, max_len=32)
    )

    # Validate optional strings
    _validate_opt_clientId = field_validator("clientId", mode="before")(
        lambda v, info: _validate_optional_string(v, info, max_len=64)
    )
    _validate_opt_relatedOrderId = field_validator("relatedOrderId", mode="before")(
        lambda v, info: _validate_optional_string(v, info, max_len=64)
    )
    _validate_opt_triggerBy = field_validator("triggerBy", mode="before")(
        lambda v, info: _validate_optional_string(v, info, max_len=32)
    )
    _validate_opt_timeInForce = field_validator("timeInForce", mode="before")(
        lambda v, info: _validate_optional_string(v, info, max_len=8)
    )
    _validate_opt_selfTradePrevention = field_validator("selfTradePrevention", mode="before")(
        lambda v, info: _validate_optional_string(v, info, max_len=32)
    )
    _validate_opt_expiryReason = field_validator("expiryReason", mode="before")(
        lambda v, info: _validate_optional_string(v, info, max_len=64)
    )
    _validate_opt_origin = field_validator("origin", mode="before")(
        lambda v, info: _validate_optional_string(v, info, max_len=64)
    )
    _validate_opt_fee_asset = field_validator("fee_asset", mode="before")(
        lambda v, info: _validate_optional_string(v, info, max_len=32)
    )
    _validate_opt_trade_id_fill = field_validator("trade_id_fill", mode="before")(
        lambda v, info: _validate_optional_string(v, info, max_len=64)
    )

    # Validate required decimal strings
    _validate_req_qty = field_validator("quantity", mode="before")(
        lambda v, info: _validate_decimal_string(v, info, allow_none=False)
    )

    # Validate optional decimal strings
    _validate_opt_exec_qty = field_validator("executedQuantity", mode="before")(
        lambda v, info: _validate_decimal_string(v, info, allow_none=True)
    )
    _validate_opt_exec_quote_qty = field_validator("executedQuoteQuantity", mode="before")(
        lambda v, info: _validate_decimal_string(v, info, allow_none=True)
    )
    _validate_opt_price = field_validator("price", mode="before")(
        lambda v, info: _validate_decimal_string(v, info, allow_none=True)
    )
    _validate_opt_trigger_price = field_validator("triggerPrice", mode="before")(
        lambda v, info: _validate_decimal_string(v, info, allow_none=True)
    )
    _validate_opt_avg_fill_price = field_validator("avgFillPrice", mode="before")(
        lambda v, info: _validate_decimal_string(v, info, allow_none=True)
    )
    _validate_opt_fill_qty = field_validator("fill_quantity", mode="before")(
        lambda v, info: _validate_decimal_string(v, info, allow_none=True)
    )
    _validate_opt_fill_price = field_validator("fill_price", mode="before")(
        lambda v, info: _validate_decimal_string(v, info, allow_none=True)
    )
    _validate_opt_fee_amount = field_validator("fee_amount", mode="before")(
        lambda v, info: _validate_decimal_string(v, info, allow_none=True)
    )

    # Validate required timestamp
    _validate_req_timestamp = field_validator("createdAt", mode="before")(
        lambda v, info: _validate_timestamp(v, info, allow_none=False)
    )

    # Validate optional timestamps
    _validate_opt_timestamp_upd = field_validator("updatedAt", mode="before")(
        lambda v, info: _validate_timestamp(v, info, allow_none=True)
    )
    _validate_opt_timestamp_trig = field_validator("triggeredAt", mode="before")(
        lambda v, info: _validate_timestamp(v, info, allow_none=True)
    )

    # Validate optional booleans (Pydantic handles basic bool parsing "true"/"false"/1/0)
    # No custom validator needed unless extra logic required

    # Add post-validation checks for enum values if desired (more strictness)
    @field_validator(
        "side", "orderType", "status", "timeInForce", "selfTradePrevention", mode="after"
    )
    @classmethod
    def check_enum_values(cls, v: str, info: ValidationInfo) -> str:
        # This runs *after* basic string validation
        field_name = info.field_name
        allowed_values: set[str] = set()
        # Define known raw values from API spec for each field
        if field_name == "side":
            allowed_values = {"buy", "sell", "Bid", "Ask"}
        elif field_name == "orderType":
            allowed_values = {"LIMIT", "MARKET"}  # Add STOP etc. if needed
        elif field_name == "status":
            allowed_values = {
                "NEW",
                "FILLED",
                "CANCELLED",
                "EXPIRED",
                "REJECTED",
                "PARTIALLY_FILLED",
                "TriggerPending",
                "TriggerFailed",
                "orderAccepted",
                "orderCancelled",
                "orderFill",
            }  # etc.
        elif field_name == "timeInForce":
            allowed_values = {"GTC", "IOC", "FOK"}
        elif field_name == "selfTradePrevention":
            allowed_values = {"RejectTaker", "RejectMaker", "RejectBoth"}
        # Add other enum fields...

        if allowed_values and v not in allowed_values:
            # Strict check: Only allow documented raw values
            raise ValueError(
                f"{field_name}: Invalid raw API value '{v}'. Expected one of {allowed_values}"
            )
            # Less strict: Allow if case-insensitive matches?
            # if v.upper() in {val.upper() for val in allowed_values}:
            #     logger.warning(f"Accepting value '{v}' for {field_name} despite case mismatch (expected one of {allowed_values})")
            #     return v # Return original if allowing case-insensitive
            # else:
            #     raise ValueError(f"{field_name}: Invalid raw API value '{v}'. Expected one of {allowed_values}")
        return v


class BackpackRawOrderBook(BaseModel):
    """Raw order book snapshot"""

    symbol: str = Field(..., max_length=64)
    bids: list[list[str]] = Field(...)  # List of [price_str, qty_str]
    asks: list[list[str]] = Field(...)  # List of [price_str, qty_str]
    time: Any = Field(...)  # Timestamp (validated below)
    # Add lastUpdateId if needed from spec
    # lastUpdateId: Optional[str] = Field(None)

    model_config = ConfigDict(populate_by_name=True, extra="forbid")

    # --- Validators ---
    _validate_symbol = field_validator("symbol", mode="before")(
        lambda v, info: _validate_required_string(v, info, max_len=64)
    )
    _validate_time = field_validator("time", mode="before")(
        lambda v, info: _validate_timestamp(v, info, allow_none=False)
    )

    @field_validator("bids", "asks", mode="before")
    @classmethod
    def validate_levels(cls, v: Any, info: ValidationInfo) -> list[list[str]]:
        """Validates structure and format of bids/asks lists."""
        field_name: str = info.field_name or "levels"
        if not isinstance(v, list):
            raise ValueError(f"{field_name}: Must be a list.")
        validated_levels: list[list[str]] = []
        for index, item in enumerate(v):
            item_field_prefix: str = f"{field_name}[{index}]"
            if not isinstance(item, list):
                raise ValueError(f"{item_field_prefix}: Item must be a list.")
            if len(item) != 2:
                raise ValueError(f"{item_field_prefix}: Item must have 2 elements [price, qty].")

            price_str: str = item[0]
            qty_str: str = item[1]

            # Validate price string (use internal helper without field name for simplicity)
            try:
                _validate_decimal_string(
                    price_str,
                    ValidationInfo(field_name=f"{item_field_prefix}.price"),
                    allow_none=False,
                )
            except ValueError as e:
                raise ValueError(f"{item_field_prefix}: Invalid price - {e}") from e

            # Validate quantity string
            try:
                _validate_decimal_string(
                    qty_str,
                    ValidationInfo(field_name=f"{item_field_prefix}.quantity"),
                    allow_none=False,
                )
            except ValueError as e:
                raise ValueError(f"{item_field_prefix}: Invalid quantity - {e}") from e

            validated_levels.append([price_str, qty_str])  # Keep original strings after validation
        return validated_levels


class BackpackRawOrderUpdate(BaseModel):
    """Raw order update event from WebSocket"""

    # Using aliases derived from previous analysis and WS spec examples
    event_type: str = Field(..., alias="e", max_length=32)
    event_time: Any = Field(..., alias="E")  # Validated below
    symbol: str = Field(..., alias="s", max_length=64)
    client_order_id: str | None = Field(None, alias="c", max_length=64)
    side: str = Field(..., alias="S", max_length=16)  # 'Bid' or 'Ask'
    order_type: str = Field(..., alias="o", max_length=32)  # 'LIMIT', 'MARKET', etc.
    time_in_force: str | None = Field(None, alias="f", max_length=8)
    quantity: str | None = Field(
        None, alias="q", max_length=64
    )  # Original requested qty? Check spec
    price: str | None = Field(None, alias="p", max_length=64)  # Limit price?
    order_status: str = Field(..., alias="X", max_length=32)  # Status like 'NEW', 'FILLED'

    # WebSocket specific fill/update fields (Aliases from WS Spec examples)
    exchange_order_id: str | None = Field(None, alias="i", max_length=64)
    quantity_filled: str | None = Field(
        None, alias="z", max_length=64
    )  # Executed quantity in this event? Or total?
    quote_quantity_filled: str | None = Field(None, alias="Z", max_length=64)  # Executed quote qty
    last_fill_quantity: str | None = Field(
        None, alias="l", max_length=64
    )  # Fill quantity for *this* event
    last_fill_price: str | None = Field(
        None, alias="L", max_length=64
    )  # Fill price for *this* event
    is_maker: bool | None = Field(None, alias="m")  # If last fill was maker
    fee_amount: str | None = Field(None, alias="n", max_length=64)  # Fee for last fill
    fee_asset: str | None = Field(None, alias="N", max_length=32)  # Fee asset for last fill
    trade_id: str | None = Field(None, alias="t", max_length=64)  # Trade ID for last fill
    engine_timestamp: Any | None = Field(None, alias="T")  # Engine timestamp (µs)
    origin: str | None = Field(None, alias="O", max_length=64)  # Origin (USER, LIQUIDATION...)
    related_order_id_ws: str | None = Field(
        None, alias="I", max_length=64
    )  # Related order ID (WS specific?)
    reduce_only_ws: bool | None = Field(None, alias="r")  # Reduce only flag (WS specific?)
    expiry_reason_ws: str | None = Field(
        None, alias="R", max_length=64
    )  # Expiry reason (WS specific?)
    stop_price_ws: str | None = Field(
        None, alias="P", max_length=64
    )  # Trigger price (WS specific?)
    trigger_by_ws: str | None = Field(None, alias="B", max_length=32)  # Trigger by (WS specific?)
    # Add TP fields a, b, d, g if needed

    model_config = ConfigDict(populate_by_name=True, extra="forbid")

    # --- Validators applying the patterns ---
    _validate_req_str32 = field_validator(
        "event_type", "order_type", "order_status", mode="before"
    )(lambda v, info: _validate_required_string(v, info, max_len=32))
    _validate_req_str64 = field_validator("symbol", mode="before")(
        lambda v, info: _validate_required_string(v, info, max_len=64)
    )
    _validate_req_str16 = field_validator("side", mode="before")(
        lambda v, info: _validate_required_string(v, info, max_len=16)
    )

    _validate_opt_str64 = field_validator(
        "client_order_id",
        "exchange_order_id",
        "related_order_id_ws",
        "trade_id",
        "expiry_reason_ws",
        "origin",
        mode="before",
    )(lambda v, info: _validate_optional_string(v, info, max_len=64))
    _validate_opt_str32 = field_validator("trigger_by_ws", "fee_asset", mode="before")(
        lambda v, info: _validate_optional_string(v, info, max_len=32)
    )
    _validate_opt_str8 = field_validator("time_in_force", mode="before")(
        lambda v, info: _validate_optional_string(v, info, max_len=8)
    )

    _validate_opt_decimal_str = field_validator(
        "quantity",
        "price",
        "quantity_filled",
        "quote_quantity_filled",
        "last_fill_quantity",
        "last_fill_price",
        "fee_amount",
        "stop_price_ws",
        mode="before",
    )(lambda v, info: _validate_decimal_string(v, info, allow_none=True))

    _validate_req_timestamp = field_validator("event_time", mode="before")(
        lambda v, info: _validate_timestamp(v, info, allow_none=False)
    )
    _validate_opt_timestamp_engine = field_validator("engine_timestamp", mode="before")(
        lambda v, info: _validate_timestamp(v, info, allow_none=True)
    )

    # Add specific Enum checks after basic validation
    @field_validator("event_type", mode="after")
    @classmethod
    def check_event_type_value(cls, v: str) -> str:
        allowed = {
            "orderAccepted",
            "orderCancelled",
            "orderExpired",
            "orderFill",
            "orderModified",
            "triggerPlaced",
            "triggerFailed",
        }
        if v not in allowed:
            raise ValueError(f"Invalid event_type value: '{v}'")
        return v

    @field_validator("side", mode="after")
    @classmethod
    def check_side_value(cls, v: str) -> str:
        allowed = {"Bid", "Ask"}  # WS uses Bid/Ask
        if v not in allowed:
            raise ValueError(f"Invalid WS side value: '{v}'")
        return v

    @field_validator("order_type", mode="after")
    @classmethod
    def check_order_type_value(cls, v: str) -> str:
        allowed = {"LIMIT", "MARKET"}  # Add others if confirmed in WS spec
        if v not in allowed:
            raise ValueError(f"Invalid WS orderType value: '{v}'")
        return v

    @field_validator("order_status", mode="after")
    @classmethod
    def check_status_value(cls, v: str) -> str:
        allowed = {
            "New",
            "Filled",
            "Cancelled",
            "Expired",
            "Rejected",
            "PartiallyFilled",
        }  # From WS spec examples (e.g., 'X' field)
        if v not in allowed:
            raise ValueError(f"Invalid WS status value: '{v}'")
        return v

    # Add validators for TIF, Origin, ExpiryReason enums if needed
