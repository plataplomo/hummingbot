# CyberDeltaEngine Configuration (Example)
# Copy this file to config.yaml and customize it.

# General settings
general:
  log_level: INFO
  safe_mode: true
  state_file: "data/state.json"
  state_backup_directory: "data/state_backups"
  state_save_interval: 300
  state_backup_count: 5

# Exchange configuration
exchanges:
  hyperliquid:
    exchange_name: "hyperliquid"
    enabled: true
    # Mainnet URLs
    api_base_url_mainnet: "https://api.hyperliquid.xyz"
    ws_url_mainnet: "wss://api.hyperliquid.xyz/ws"
    # Testnet URLs
    api_base_url_testnet: "https://api.hyperliquid-testnet.xyz"
    ws_url_testnet: "wss://api.hyperliquid-testnet.xyz/ws"
    # Environment flag - set to false to use testnet (default for development)
    is_mainnet_environment: false
    # Hyperliquid-specific rate limiting configuration
    ip_weight_limit_per_minute: 1140
    info_request_type_ip_weights:
      l2Book: 2                 # Level 2 Order Book
      allMids: 2                # All Mid Prices
      clearingHouseState: 20    # User state
      meta: 2                   # Exchange metadata
      userRole: 60              # User role check
      openOrders: 2             # Open orders
      historicalOrders: 20      # Historical orders
      orderStatus: 2            # Single order status
      fundingHistory: 20        # Funding history
      recentTrades: 20          # Recent trades
    default_info_weight: 20
    exchange_action_base_ip_weight: 1
    address_action_safety_net:
      rate_per_minute: 300
    websocket_send_rate_per_minute: 1800
    symbols:
      BTC: "BTC"
      ETH: "ETH"
    # Optional HTTP Client Settings (examples - can be omitted to use defaults)
    request_timeout_seconds: 20
    ws_ping_interval_seconds: 25
    # ws_max_reconnect_attempts: 5  # Example of another optional field
    # Exchange-Specific Parameters (required for Hyperliquid)
    chain_id: 1337

  backpack:
    exchange_name: "backpack"
    enabled: true
    # Mainnet URLs (Backpack currently only has mainnet)
    api_base_url_mainnet: "https://api.backpack.exchange"
    ws_url_mainnet: "wss://ws.backpack.exchange"
    # Testnet URLs not provided (Backpack doesn't have testnet)
    # api_base_url_testnet: null
    # ws_url_testnet: null
    # Environment flag - always true for Backpack as they only have mainnet
    is_mainnet_environment: true
    rate_limit_per_minute: 120
    symbols:
      BTC: "BTC_USDC"
      ETH: "ETH_USDC"
    # Optional HTTP Client Settings (examples - can be omitted to use defaults)
    request_timeout_seconds: 15.0
    # chain_id is not required for Backpack, so it can be omitted
    # Other optional HTTP/WS fields can be omitted to use system defaults

# Strategy configuration
strategies:
  hl_perp_bp_spot:
    enabled: true
    long_exchange: "hyperliquid"
    short_exchange: "backpack"
    symbol_long: "BTC"
    symbol_short: "BTC"
    params:
      funding_threshold: 0.0001
      max_price_spread_pct: 0.002
      min_profit_usd: 1.0

# Risk management
risk:
  global:
    max_position_usd: 1000.0
    max_total_exposure_usd: 5000.0

  # --- Simple Sizing Path (Optional Alternative to Kelly) ---
  use_simple_sizing_path: false
  simple_sizing_method: "fixed_fraction"
  simple_fixed_fraction: "0.01"
  simple_fixed_usd_size: "100.0"

# Execution parameters
execution:
  max_slippage_pct: 0.001
  max_retries: 3
  retry_delay_base_sec: 1.0
  settlement_delay: 2.0
  compensation:
    use_limit_orders: true
    limit_price_offset_pct: 0.05

# Safety Systems Configuration
safety_systems:
  circuit_breakers:
    enabled: true
    global_consecutive_failures: 5
    global_reset_timeout_sec: 300
    exchange_consecutive_failures: 3
    exchange_reset_timeout_sec: 180

  position_reconciliation:
    enabled: true
    check_interval_sec: 600
    max_discrepancy_pct: 0.01

  balance_monitoring:
    enabled: true
    check_interval_sec: 300
    min_balance_thresholds_usd:
      hyperliquid: 100.0
      backpack: 100.0

# Monitoring and Notifications
monitoring:
  notifications_enabled: true
  alert_methods: ["log"]

# Portfolio Tracker Configuration
portfolio_tracker:
  data_freshness_seconds: 60
  initial_balances: {}  # Example: { "hyperliquid": { "USDC": "10000.00" } }
  initial_positions: []  # Example: List of initial derivative positions
