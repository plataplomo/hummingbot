# CyberDeltaEngine Secrets Configuration (Example)
# Copy this file to your secrets location (e.g., ~/.cyberdelta/secrets.yaml)
# and add your actual credentials.
# IMPORTANT: DO NOT COMMIT YOUR ACTUAL SECRETS.

exchanges:
  hyperliquid:
    auth_type: "private_key"
    private_key: "YOUR_HYPERLIQUID_WALLET_PRIVATE_KEY_0x..."
    # passphrase: "YOUR_HYPERLIQUID_PASSPHRASE_IF_ANY"  # Optional - for encrypting main private_key
    # Optional: Dedicated private key for Hyperliquid testnet
    # private_key_testnet: "YOUR_HYPERLIQUID_TESTNET_WALLET_PRIVATE_KEY_0x..."
    # testnet_seed_passphrase: "YOUR_BIP39_SEED_FOR_TESTNET"  # Optional BIP-39 seed for testnet wallets
    # Note: When is_mainnet_environment is false, the system looks for keys in this order:
    # 1. testnet_seed_passphrase (to derive wallets), 2. private_key_testnet, 3. falls back to private_key
  backpack:
    auth_type: "api_key"  # Backpack uses its ED25519 keys here
    api_key: "YOUR_BACKPACK_ED25519_PUBLIC_KEY_B64"
    api_secret: "YOUR_BACKPACK_ED25519_PRIVATE_KEY_B64"
  # Example for a traditional API key/secret exchange (if added later)
  # some_other_exchange:
  #   auth_type: "api_key"
  #   api_key: "TRADITIONAL_API_KEY"
  #   api_secret: "TRADITIONAL_API_SECRET"

notifications:
  telegram:
    bot_token: "YOUR_TELEGRAM_BOT_TOKEN"
    chat_id: "YOUR_TELEGRAM_CHAT_ID"

logfire:
  write_token: "YOUR_LOGFIRE_WRITE_TOKEN"
