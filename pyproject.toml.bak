# ===============================
# Build System Configuration
# ===============================
[build-system]
requires = ["setuptools>=61.0", "wheel"]
build-backend = "setuptools.build_meta"

# ===============================
# Project Metadata
# ===============================
[project]
name = "CyberDeltaEngine" # CORRECTED Project Name
version = "0.0.1"
description = "Automated trading engine for delta-neutral funding rate arbitrage strategies between crypto exchanges (Hyperliquid, Backpack)." # CORRECTED Description
readme = { file = "README.md", content-type = "text/markdown" }
requires-python = ">=3.13"
license = { text = "MIT" } # Or your chosen license
authors = [
    {name = "plataplomo", email = "bizonum@gmail.com"},
]
classifiers = [
    "Development Status :: 3 - Alpha", # Changed to Alpha
    "Intended Audience :: Developers",
    "Intention Audience :: Financial and Insurance Industry",
    "License :: OSI Approved :: MIT License",
    "Programming Language :: Python",
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: 3.13",
    "Topic :: Office/Business :: Financial :: Investment", # CORRECTED Topic
    "Topic :: Software Development :: Libraries :: Python Modules",
]

# ===============================
# Core Dependencies (Minimal v0.0.1 Set - REVIEW AND PRUNE FURTHER)
# ===============================
dependencies = [
    "aiohttp >= 3.8.5, < 4.0.0",      # Async HTTP Client (for APIs)
    "websockets >= 11.0, < 13.0",    # WebSocket Client (often preferred over aiohttp's) - Choose ONE with aiohttp if needed
    "PyYAML >= 6.0, < 7.0",          # Configuration loading
    "numpy >= 1.21.0, < 1.27.0",     # Numerical (likely needed for Decimal/Pandas interactions or risk calcs) - keep version reasonable
    "pandas >= 1.4.0, < 2.3.0",      # Data analysis (Check if Portfolio/Strategy/Validation *truly* needs it for v0.0.1, or use lists/dicts) - KEEP IF NEEDED
    "python-dateutil >= 2.8.0, < 3.0.0", # Datetime utilities (often pulled by Pandas)
    "pytz",                          # Timezone database (often pulled by Pandas)
    "tzdata",                        # Timezone data (often pulled by Pandas)
    "eth-account >= 0.11.0, < 0.12.0", # For Hyperliquid EIP-712 Signing
    "PyNaCl >= 1.5.0, < 1.6.0",      # For Backpack ED25519 Signing (if confirmed mechanism) - Verify this is needed!
    "structlog >= 23.0, < 25.0",     # Structured logging (Recommended)
    # REMOVED: ijson, ujson (use standard json), tqdm, argparse (use stdlib), chardet, discord.py, aiofiles, python-dotenv, keyring
    # ADD BACK dependencies ONLY if proven necessary for core v0.0.1 functionality.
]

# ===============================
# Optional Dependencies (Minimal Dev/Test Set)
# ===============================
[project.optional-dependencies]
dev = [
    "ruff >= 0.4.1, < 0.5.0",          # Linter, Formatter, Import Sorter
    "mypy >= 1.9.0, < 1.10.0",         # Strict Static Type Checker
    "pytest >= 7.0.1, < 8.2.0",        # Testing Framework
    "pytest-asyncio >= 0.21.1, < 0.24.0",# Asyncio support for pytest (Check compatibility!)
    "pytest-cov >= 4.0.0, < 5.1.0",    # Coverage reporting for pytest
    "pytest-mock >= 3.12.0, < 3.15.0", # Mocking utility for pytest
    # REQUIRED TYPE STUBS (Add based on Mypy errors for installed packages)
    "types-PyYAML >= 6.0",
    "types-python-dateutil >= 2.8",
    "types-pytz",
    # Add types-* for other deps like aiohttp if needed and available
    # REMOVED: black, isort, pylint, numerous pytest plugins (xdist, lazy-fixture, anyio, env, benchmark, randomly, vcr, freezegun, hypothesis)
]
# REMOVED: viz, docs, ai sections as they are out of scope for v0.0.1

# ===============================
# Setuptools Configuration
# ===============================
[tool.setuptools]
packages = { find = { where = ["src"], exclude = ["tests", "*.tests", "*.tests.*", "tests.*", "examples", "current_workflow"] } } # Exclude more dirs
include-package-data = true

# ===============================
# Ruff Configuration (Replaces Black, Isort, most Flake8 plugins)
# ===============================
[tool.ruff]
# Assume Python 3.13+ features.
target-version = "py313"
line-length = 100
# Specify source directory
src = ["src", "tests"] # Include tests in checks
exclude = [ # Standard excludes + workflow
    ".bzr", ".direnv", ".eggs", ".git", ".git-rewrite", ".hg", ".mypy_cache",
    ".nox", ".pants.d", ".pytype", ".ruff_cache", ".svn", ".tox", ".venv",
    "__pypackages__", "_build", "buck-out", "build", "dist", "node_modules",
    "venv", "venv_lint", "current_workflow", # Explicitly exclude workflow
]

[tool.ruff.lint]
# Rule Selection: Start strict, then ignore specific cases if necessary
# E = pycodestyle errors, W = pycodestyle warnings, F = pyflakes, I = isort
# B = flake8-bugbear, C4 = flake8-comprehensions, UP = pyupgrade
# ANN = flake8-annotations, TCH = flake8-type-checking, RUF = ruff-specific
# ARG = flake8-unused-arguments, PLC = Pylint Convention, PLE = Pylint Error
# PLR = Pylint Refactor, PLW = Pylint Warning, TID = flake8-tidy-imports
# SIM = flake8-simplify, PTH = flake8-use-pathlib, TRY = tryceratops
select = ["E", "W", "F", "I", "B", "C4", "UP", "ANN", "TCH", "RUF", "ARG", "PLC", "PLE", "PLR", "PLW", "TID", "SIM", "PTH", "TRY"]

# Ignored Rules: START WITH NONE. Add specific ignores ONLY if absolutely necessary
# and justified with a comment here and potentially a noqa inline.
# Example: ignore = ["ANN101", "ANN102"] # If project decides against self/cls hints
ignore = []

# Allow unused arguments in specific locations if needed (e.g., required by interface)
# dummy-variable-rgx = "^(_+|(_+[a-zA-Z0-9_]*[a-zA-Z0-9]+?))$"

[tool.ruff.lint.per-file-ignores]
# Allow unused imports (F401) and module-level imports (E402) in __init__.py
"__init__.py" = ["F401", "E402"]
# Example: Slightly relax ANN rules for test files if needed (prefer fixing though)
# "tests/**/*.py" = ["ANN001", "ANN201"]

[tool.ruff.lint.isort]
# Define project structure for import sorting
known-first-party = ["cyberdelta", "tests"] # Adjust 'cyberdelta' if your top src folder is different

[tool.ruff.format]
# Use defaults similar to Black, or customize as needed
quote-style = "double"
indent-style = "space"
skip-magic-trailing-comma = false
line-ending = "lf"

# ===============================
# Mypy Configuration (Strict)
# ===============================
[tool.mypy]
python_version = "3.13"

# Core Strictness Flags
check_untyped_defs = true
disallow_any_generics = true
disallow_incomplete_defs = true
disallow_subclassing_any = true
disallow_untyped_calls = true
disallow_untyped_decorators = true
disallow_untyped_defs = true
no_implicit_optional = true
no_implicit_reexport = true
strict_equality = true
warn_incomplete_stub = true
warn_redundant_casts = true
warn_return_any = true
warn_unreachable = true
warn_unused_configs = true
warn_unused_ignores = true

# Exclude directories from checking
exclude = ['\.venv', 'current_workflow', 'build', 'dist', 'docs', 'examples']

# Fine-grained Overrides (Example for Tests)
[[tool.mypy.overrides]]
module = "tests.*"
# Slightly relax rules for tests if necessary, e.g.:
# allow_untyped_defs = true
# check_untyped_defs = false
disallow_untyped_defs = false # Allow untyped test helpers/fixtures if needed
disallow_incomplete_defs = false

# Ignore missing imports for libraries without stubs
[[tool.mypy.overrides]]
module = [
    # Add modules known to lack stubs here
    # "some_third_party_lib.*",
]
ignore_missing_imports = true

# ===============================
# Pytest Configuration
# ===============================
[tool.pytest.ini_options]
testpaths = ["tests"]
python_paths = ["src"] # Assumes source code is in 'src/'
python_files = "test_*.py"
python_classes = "Test*"
python_functions = "test_*"
# Basic addopts - coverage reports generated separately if needed by CI/other scripts
addopts = "-v --tb=short"
# Filter annoying warnings if necessary (prefer fixing code though)
# filterwarnings = [
#     "ignore::DeprecationWarning",
# ]
# Define markers used in tests
markers = [
    "unit: Mark test as a unit test.",
    "integration: Mark test as an integration test.",
    "failure: Mark test as a failure scenario test.",
    "slow: Mark test as slow running.",
]
# asyncio_mode = "auto" # Default asyncio mode