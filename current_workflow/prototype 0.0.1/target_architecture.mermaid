graph TD
    %% Main Application Orchestration
    Main[main.py<br>TradingBot] --> Initialize
    Initialize --> RunComponents
    
    %% Core Components
    subgraph CoreComponents[Core Components]
        subgraph DataLayer[Data Layer]
            DH[Data Handler<br>- Market Data<br>- Websocket Processing]
            PT[Portfolio Tracker<br>- Balance/Position State<br>- PnL Calculation]
        end
        
        subgraph StrategyLayer[Strategy Layer]
            SG[Signal Generator<br>- NFD Calculation<br>- Opportunity Ranking]
            RM[Risk Manager<br>- VaR/CVaR<br>- Position Sizing<br>- Pre-trade Checks]
        end
        
        subgraph ExecutionLayer[Execution Layer]
            EH[Execution Handler<br>- Parallel Order Placement<br>- Monitoring & Recovery]
            CM[Collateral Manager<br>- Transfer Planning<br>- Bridge Integration]
        end
        
        AL[Adaptation Loop<br>- Performance Metrics<br>- Parameter Tuning]
    end
    
    RunComponents --> DH
    RunComponents --> PT
    RunComponents --> SG
    RunComponents --> RM
    RunComponents --> EH
    RunComponents --> CM
    RunComponents --> AL
    
    %% Data Flow
    DH --> |Orderbook/Ticker Data| SG
    DH --> |Market Data| RM
    PT --> |Positions/Balances| RM
    PT --> |Performance History| AL
    
    SG --> |Opportunities| RM
    RM --> |Sized/Filtered Opportunities| EH
    RM --> |Collateral Needs| CM
    
    EH --> |Execution Results| PT
    CM --> |Transfer Results| PT
    
    AL --> |Tuned Parameters| SG
    AL --> |Risk Limits| RM
    
    %% External Connections
    subgraph ExchangeAPIs[Exchange API Clients]
        HyperAPI[Hyperliquid API<br>- REST/WS<br>- Wallet Integration]
        BackAPI[Backpack API<br>Future]
        ParaAPI[Paradex API<br>Future]
    end
    
    subgraph ExternalServices[External Services]
        Bridges[Bridge APIs<br>Future]
        Oracles[Oracle APIs<br>Future]
    end
    
    subgraph SupportSystems[Support Systems]
        Config[Configuration<br>- YAML Settings<br>- .env Secrets]
        Logging[Logging System<br>- Console/File<br>- Structured Logs]
        Testing[Testing Framework<br>- Unit Tests<br>- Simulation]
        Monitoring[Monitoring<br>- CLI Interface<br>- Future Dashboard]
    end
    
    %% API Connections
    DH <--> HyperAPI
    EH <--> HyperAPI
    PT <--> HyperAPI
    CM <--> HyperAPI
    
    CM <--> |Future| Bridges
    RM <--> |Future| Oracles
    
    %% Support Connections
    Config --> Main
    Main --> Logging
    Logging --> DH
    Logging --> SG
    Logging --> RM
    Logging --> EH
    Logging --> CM
    Logging --> PT
    Logging --> AL
    
    Testing --> Main
    Testing --> DH
    Testing --> SG
    Testing --> RM
    Testing --> EH
    Testing --> CM
    
    Monitoring --> Main
    Monitoring --> PT
    
    %% Styling
    classDef core fill:#f9f,stroke:#333,stroke-width:1px
    classDef api fill:#ccf,stroke:#333,stroke-width:1px
    classDef support fill:#cfc,stroke:#333,stroke-width:1px
    classDef future fill:#eee,stroke:#333,stroke-width:1px,stroke-dasharray: 5 5
    
    class Main,Initialize,RunComponents core
    class DH,PT,SG,RM,EH,CM,AL core
    class HyperAPI,BackAPI,ParaAPI api
    class Config,Logging,Testing,Monitoring support
    class Bridges,Oracles,BackAPI,ParaAPI future 